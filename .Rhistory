tag <- if (length(rho_verd) == 0 || all(rho_verd == 0)) "rho0" else sprintf("%.2f", rho_verd[1])
message("\n================= Cenário ", j, " =================")
message("K = ", K, " | nk = ", nk[1], " | tag = ", tag)
for (r in seq_len(R)) {
sim_file <- sprintf("SimTestlet2PP_%d_%d_%s_%d.rds", K, nk[1], tag, r)
sim_path <- file.path(pathSim, sim_file)
if (!file.exists(sim_path)) {
message("Arquivo de simulação não encontrado, pulando: ", sim_file)
next
}
dat <- readRDS(sim_path)
if (is.null(dat$Y)) {
message("dat$Y ausente em: ", sim_file, " — pulando.")
next
}
Y <- dat$Y
if (!is.matrix(Y)) Y <- as.matrix(Y)
storage.mode(Y) <- "integer"
N <- nrow(Y); I <- ncol(Y)
# Estrutura por regra simples: HU se nk == 2; HT caso contrário
structure_vec <- rep(ifelse(nk[1] == 2, "HU", "HT"), K)
# Hiperparâmetros (nível selecionado acima)
hyper <- get_hypers(prior_level)
# Inits compartilhados: theta pelos escores padronizados; a/b pequenos
scores <- rowSums(Y)
sc <- sd(scores); if (is.na(sc) || sc == 0) sc <- 1
scores <- (scores - mean(scores)) / sc
## ========== AJUSTE TESTLET (se solicitado) ==========
if (model_to_fit %in% c("testlet","both")) {
data_list_testlet <- montar_data_list_testlet(
Y = Y, K = K, nk = nk, dk = dk,
structure = structure_vec,
hypers = hyper
)
nRho <- sum(data_list_testlet$rho_len)
ini_testlet <- function() {
list(
theta      = as.numeric(scores),
a          = rep(0.1, I),
b          = rep(0.1, I),
rho_global = if (nRho > 0) rep(.1, nRho) else numeric(0)
)
}
monitor_pars_testlet <- c("theta", "a", "b", "rho_global")
fit_testlet <- tryCatch(
{
sampling(
object  = sm_testlet,
data    = data_list_testlet,
chains  = nChains,
iter    = nIter,
thin    = thinSteps,
warmup  = burnInSteps,
pars    = monitor_pars_testlet,
control = list(adapt_delta = nutsc$adapt_delta,
max_treedepth = nutsc$max_treedepth),
init    = ini_testlet,
refresh = 200
)
},
error = function(e) {
message("Falha no sampling (Testlet) para ", sim_file, ": ", conditionMessage(e))
return(NULL)
}
)
if (!is.null(fit_testlet)) {
summary_file <- file.path(
pathFit,
sprintf("Summary_Testlet_%d_%d_%s_%d.rds", K, nk[1], tag, r)
)
save_fit_summary(fit_testlet, summary_file, pars = monitor_pars_testlet)
message("Salvo (Testlet): ", basename(summary_file))
}
}
## ========== AJUSTE 2PP USUAL (se solicitado) ==========
if (model_to_fit %in% c("2pp","both")) {
data_list_2pp <- montar_data_list_2pp(
Y = Y,
hypers = list(sigma_a = hyper$sigma_a, sigma_b = hyper$sigma_b)
)
ini_2pp <- function() {
list(
theta = as.numeric(scores),
a     = rep(0.1, data_list_2pp$vI),
b     = rep(0.1, data_list_2pp$vI)
)
}
monitor_pars_2pp <- c("theta", "a", "b")
fit_2pp <- tryCatch(
{
sampling(
object  = sm_2pp,
data    = data_list_2pp,
chains  = nChains,
iter    = nIter,
thin    = thinSteps,
warmup  = burnInSteps,
pars    = monitor_pars_2pp,
