refresh = 200
)
},
error = function(e) {
message("Falha no sampling (2PP) para ", sim_file, ": ", conditionMessage(e))
return(NULL)
}
)
if (!is.null(fit_2pp)) {
summary_file_2pp <- file.path(
pathFit,
sprintf("Summary_2PP_%d_%d_%s_%d.rds", K, nk[1], tag, r)
)
save_fit_summary(fit_2pp, summary_file_2pp, pars = monitor_pars_2pp)
message("Salvo (2PP): ", basename(summary_file_2pp))
}
}
} # fim loop réplicas
} # fim loop cenários
