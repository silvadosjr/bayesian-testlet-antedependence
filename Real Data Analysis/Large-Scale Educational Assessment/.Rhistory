# --- Estimativas dos modelos NOS MESMOS tempos do KM -------------
S_exp    <- get_surv(exp_fit,    df_km$t)
S_wei    <- get_surv(wei_fit,    df_km$t)
S_ln     <- get_surv(ln_fit,     df_km$t)
S_llogis <- get_surv(llogis_fit, df_km$t)
df_compare <- df_km %>%
mutate(`Exponencial`   = S_exp,
`Weibull`       = S_wei,
`Log-normal`    = S_ln,
`Log-logística` = S_llogis) %>%
pivot_longer(cols = c(`Exponencial`, `Weibull`, `Log-normal`, `Log-logística`),
names_to = "Modelo", values_to = "S_modelo")
# --- Transformações para linearização ----------------------------
df_lin <- bind_rows(
transmute(df_km,
Modelo = "Exponencial",
x = t,
y = -log(KM)),
transmute(df_km,
Modelo = "Weibull",
x = log(t),
y = log(-log(KM))),
transmute(df_km,
Modelo = "Log-normal",
x = log(t),
y = qnorm(1 - KM)),  # Phi^{-1}[1 - S(t)]
transmute(df_km,
Modelo = "Log-logística",
x = log(t),
y = log((1 - KM) / KM))
)
df_lin$Modelo <- factor(df_lin$Modelo,
levels = c("Exponencial", "Weibull", "Log-normal", "Log-logística"))
# ----- Rótulos das faixas como EXPRESSÕES (usando strings + label_parsed)
facet_labs <- c(
"Exponencial" = "Exponencial:~-log(S(t))~vs.~t",
"Weibull"     = "Weibull:~log(-log(S(t)))~vs.~log(t)",
"Log-normal"  = "Log-normal:~Phi^-1*(1-S(t))~vs.~log(t)",
"Log-logística" = "Log-logística:  log((1-S(t))/S(t))~vs.~log(t)"
)
lab_fun <- as_labeller(facet_labs, label_parsed)
# ----- Painel
p_lin <- ggplot(df_lin, aes(x = x, y = y)) +
geom_point(size = 2) +
facet_wrap(~ Modelo, nrow = 1, scales = "free", labeller = lab_fun) +
labs(
title = "Gráficos de linearização da função de sobrevivência (a partir de KM)",
x = NULL, y = NULL
) +
theme_minimal(base_size = 14) +
theme(
strip.text = element_text(face = "bold"),
plot.title = element_text(face = "bold"),
panel.grid.minor = element_blank()
)
print(p_lin)
ggsave(file.path(fig_dir, "Painel_Linearizacao_Sobrevivencia_Isoladores.png"),
plot = p_panel, width = 11, height = 4, dpi = 300)
ggsave(file.path(fig_dir, "Painel_Linearizacao_Sobrevivencia_Isoladores.png"),
plot = p_lin, width = 11, height = 4, dpi = 300)
# Tabela de AIC e BIC -----------------------------------------
tab_ic <- data.frame(
Modelo = c("Exponencial", "Weibull", "Log-normal",'Log-logística'),
AIC    = c(AIC(exp_fit), AIC(wei_fit), AIC(ln_fit), AIC(llogis_fit)),
BIC    = c(BIC(exp_fit), BIC(wei_fit), BIC(ln_fit), BIC(llogis_fit))
)
print(tab_ic)
# Se precisar (apenas para a tabela bonita):
# install.packages("knitr")
library(knitr)
# 1) Ajuste da Gama Generalizada (modelo completo, 3 parâmetros)
gg_fit <- flexsurvreg(surv_obj ~ 1, dist = "gengamma")
# 2) Coletar log-verossimilhanças e nº de parâmetros ----------------------
logL <- c(
"Gama generalizada" = gg_fit$loglik,
"Exponencial"       = exp_fit$loglik,
"Weibull"           = wei_fit$loglik,
"Log-normal"        = ln_fit$loglik
)
k <- c(
"Gama generalizada" = 3,
"Exponencial"       = 1,
"Weibull"           = 2,
"Log-normal"        = 2
)
# 3) Estatísticas TRV, g.l. e valores-p -----------------------------------
# referência: modelo completo (maior logL) — aqui, Gama generalizada
ref_name <- names(which.max(logL))
LL_ref   <- logL[ref_name]
TRV <- 2 * (LL_ref - logL)
df  <- k[ref_name] - k
pval <- ifelse(names(logL) == ref_name, NA_real_,
pchisq(TRV, df = df, lower.tail = FALSE))
# 4) Formatação (vírgula decimal, TRV mostrando a conta) -------------------
fmt  <- function(x, d = 2) formatC(x, format = "f", digits = d, decimal.mark = ",")
dash <- function(x) ifelse(is.na(x), "\u2014", x)    # en dash
TRV_txt <- mapply(function(name, trv){
if (name == ref_name) return("\u2014")
paste0("2(", fmt(abs(logL[name])), " \u2212 ", fmt(abs(LL_ref)), ") = ", fmt(trv))
}, names(logL), TRV, USE.NAMES = FALSE)
tab_trv <- data.frame(
Modelo       = names(logL),
`log[L(θ̂)]` = fmt(logL),
TRV          = TRV_txt,
`Valor p`    = dash(ifelse(is.na(pval), NA, fmt(pval, 3))),
check.names = FALSE
)
# 5) Exibir (LaTeX/HTML) ---------------------------------------------------
kable(
tab_trv,
align   = c("l","r","l","r"),
booktabs = TRUE,
caption = "Resultados do TRV associados aos modelos ajustados"
)
# Extraia as estimativas e matriz de covariância
coef_ln <- ln_fit$res[, "est"]
names(coef_ln) <- c("mu", "sigma")
vcov_ln <- ln_fit$cov   # matriz 2x2 com var(mu), var(sigma) e cov(mu,sigma)
# Converte para a ESCALA NATURAL (mu, sigma)
# J = diag(c(1, sigma_hat))
mu_hat    <- coef_ln["mu"]
sigma_hat <- coef_ln["sigma"]
J <- matrix(c(1, 0, 0, sigma_hat), nrow = 2, byrow = TRUE)
vcov_ln<- J%*%vcov_ln%*%t(J)  # Cov(mu, sigma) na escala natural
# --- Funções auxiliares para o método delta -------------------------
# Média: E(T) = exp(mu + sigma^2 / 2)
E_T <- exp(mu_hat + sigma_hat^2 / 2)
# Gradiente (derivadas parciais)
d_mu    <- E_T                      # d/dmu
d_sigma <- E_T * sigma_hat          # d/dsigma
grad_E <- c(d_mu, d_sigma)
# Variância delta: Var[E(T)] ≈ grad' * Cov * grad
var_E <- t(grad_E) %*% vcov_ln %*% grad_E
se_E  <- sqrt(var_E)
# Intervalo de 95% IC(E(T))
z <- qnorm(0.975)
IC_E <- c(E_T - z * se_E, E_T + z * se_E)
# --- Mediana: t_0.5 = exp(mu + sigma * z_0.5) = exp(mu)
t_med <- exp(mu_hat)
# Gradiente da mediana
d_mu_med    <- t_med
d_sigma_med <- 0
grad_med <- c(d_mu_med, d_sigma_med)
# Variância e IC(delta)
var_med <- t(grad_med) %*% vcov_ln %*% grad_med
se_med  <- sqrt(var_med)
IC_med <- c(t_med - z * se_med, t_med + z * se_med)
# --- Resultados finais --------------------------------------------
cat("\nEstimativas sob modelo log-normal\n")
cat(sprintf("Média estimada: %.2f horas (IC95%%: %.1f ; %.1f)\n",
E_T, IC_E[1], IC_E[2]))
cat(sprintf("Mediana estimada: %.2f horas (IC95%%: %.1f ; %.1f)\n",
t_med, IC_med[1], IC_med[2]))
ln_fit
ln_fit$res
ln_fit$res.t
coef_ln
ln_fit
ln_fit$res.t
## ------------------------------
## Dinâmica: Contagem por aluno
## ------------------------------
set.seed(123)
# Função para gerar um baralho (apenas valores 1 a 13)
gera_baralho <- function() {
rep(1:13, each = 4)
}
# Função que produz a trajetória de um aluno
trajetoria_aluno <- function(numero_escolhido, baralho) {
X <- numeric(length(baralho))
count <- 0
for (i in seq_along(baralho)) {
if (baralho[i] == numero_escolhido) count <- count + 1
X[i] <- count
}
return(X)
}
# ------- Simulação --------
n_alunos <- 8                        # número de alunos simulados
escolhas <- sample(1:13, n_alunos)   # cada aluno escolhe um número
baralho  <- sample(gera_baralho())   # embaralha o baralho
# Obtém trajetórias
traj <- lapply(escolhas, trajetoria_aluno, baralho = baralho)
View(traj)
traj[[2]]
# Coloca tudo em data frame longo
library(tidyverse)
df <- tibble(
carta   = rep(1:52, times = n_alunos),
aluno   = rep(paste0("Aluno_", seq_len(n_alunos)), each = 52),
escolha = rep(escolhas, each = 52),
X       = unlist(traj)
)
View(df)
ggplot(df, aes(x = carta, y = X, color = aluno)) +
geom_line(linewidth = 1) +
geom_point(size = 1.3) +
labs(
title = "Dinâmica de Processos Estocásticos: Contagem ao Revelar o Baralho",
subtitle = "Cada aluno conta somente as ocorrências do número que escolheu",
x = "Carta revelada",
y = "Contagem acumulada (X_n)"
) +
theme_minimal(base_size = 14) +
theme(legend.position = "bottom")
# ---------------------------------------------------------------
# Dinâmica do Baralho: Cartas reveladas uma a uma (Shiny)
# Para projeção em sala de aula
# ---------------------------------------------------------------
library(shiny)
library(tidyverse)
# -------------------------------
# Funções auxiliares
# -------------------------------
gera_baralho <- function() {
rep(1:13, each = 4)
}
trajetoria_aluno <- function(numero_escolhido, baralho, n) {
# trajetória até a carta n
X <- numeric(n)
count <- 0
for (i in 1:n) {
if (baralho[i] == numero_escolhido) count <- count + 1
X[i] <- count
}
return(X)
}
# -------------------------------
# UI
# -------------------------------
ui <- fluidPage(
titlePanel("Dinâmica de Processos Estocásticos: Contagem ao Revelar o Baralho"),
sidebarLayout(
sidebarPanel(
numericInput("nAlunos", "Número de alunos (simulados):", 6, min = 1, max = 20),
actionButton("sortear", "Sortear números dos alunos"),
hr(),
actionButton("revelar", "Revelar próxima carta"),
actionButton("reset", "Reiniciar"),
hr(),
verbatimTextOutput("infoCarta")
),
mainPanel(
plotOutput("grafico", height = "500px")
)
)
)
# -------------------------------
# Server
# -------------------------------
server <- function(input, output, session) {
# estado reativo
estado <- reactiveValues(
baralho = NULL,
escolhas = NULL,
n_atual = 0
)
# Sortear números
observeEvent(input$sortear, {
estado$baralho <- sample(gera_baralho())
estado$escolhas <- sample(1:13, input$nAlunos, replace = TRUE)
estado$n_atual <- 0
})
# Revelar próxima carta
observeEvent(input$revelar, {
req(estado$baralho)
if (estado$n_atual < 52) {
estado$n_atual <- estado$n_atual + 1
}
})
# Reiniciar
observeEvent(input$reset, {
estado$baralho <- NULL
estado$escolhas <- NULL
estado$n_atual <- 0
})
# Informação da carta atual
output$infoCarta <- renderText({
if (is.null(estado$baralho) || estado$n_atual == 0) {
return("Nenhuma carta revelada ainda.")
}
paste0("Carta ", estado$n_atual, ": valor = ", estado$baralho[estado$n_atual])
})
# Gráfico atualizado
output$grafico <- renderPlot({
req(estado$baralho, estado$escolhas)
n <- estado$n_atual
if (n == 0) return(NULL)
trajetorias <- lapply(
estado$escolhas,
trajetoria_aluno,
baralho = estado$baralho,
n = n
)
df <- tibble(
carta   = rep(1:n, times = input$nAlunos),
aluno   = rep(paste0("Aluno_", 1:input$nAlunos), each = n),
escolha = rep(estado$escolhas, each = n),
X       = unlist(trajetorias)
)
ggplot(df, aes(x = carta, y = X, color = aluno)) +
geom_line(linewidth = 1.2) +
geom_point(size = 2) +
labs(
title = "Trajetórias de Contagem ao Revelar as Cartas",
subtitle = "As sequências variam no início, mas estacionam quando não há mais ocorrências do número escolhido",
x = "Carta revelada",
y = "Contagem acumulada X_n"
) +
theme_minimal(base_size = 16) +
theme(legend.position = "bottom")
})
}
# -------------------------------
# Run App
# -------------------------------
shinyApp(ui, server)
# ---------------------------------------------------------------
# Dinâmica Generalizada: m baralhos + N cartas reveladas
# ---------------------------------------------------------------
library(shiny)
library(tidyverse)
# -------------------------------
# Funções auxiliares
# -------------------------------
gera_baralhos <- function(m) {
# m baralhos → cada valor aparece 4*m vezes
rep(1:13, each = 4 * m)
}
trajetoria_aluno <- function(numero_escolhido, baralho, n) {
X <- numeric(n)
count <- 0
for (i in 1:n) {
if (baralho[i] == numero_escolhido) count <- count + 1
X[i] <- count
}
X
}
# -------------------------------
# UI
# -------------------------------
ui <- fluidPage(
titlePanel("Dinâmica de Processos Estocásticos — m Baralhos e N Cartas"),
sidebarLayout(
sidebarPanel(
numericInput("m", "Número de baralhos:", 3, min = 1, max = 20),
numericInput("N", "Número de cartas a revelar:", 60, min = 1),
numericInput("nAlunos", "Número de alunos (simulados):", 6, min = 1, max = 50),
actionButton("sortear", "Gerar baralho e sortear números"),
hr(),
actionButton("revelar", "Revelar próxima carta"),
actionButton("reset", "Reiniciar"),
hr(),
verbatimTextOutput("infoCarta"),
verbatimTextOutput("escolhasAlunos")
),
mainPanel(
fluidRow(
column(6, plotOutput("grafico", height = "500px")),
column(6, uiOutput("imagemCarta"))
)
)
)
)
# -------------------------------
# SERVER
# -------------------------------
server <- function(input, output, session) {
estado <- reactiveValues(
baralho = NULL,
escolhas = NULL,
n_atual = 0,
Nmax = NULL
)
# Sortear setup inicial
observeEvent(input$sortear, {
# criar N cartas de m baralhos
baralho_full <- sample(gera_baralhos(input$m))
# garantir que temos cartas suficientes
if (input$N > length(baralho_full)) {
estado$Nmax <- length(baralho_full)
} else {
estado$Nmax <- input$N
}
# selecionar N cartas
estado$baralho <- baralho_full[1:estado$Nmax]
# alunos escolhem
estado$escolhas <- sample(1:13, input$nAlunos, replace = TRUE)
estado$n_atual <- 0
})
# Revelar carta
observeEvent(input$revelar, {
req(estado$baralho)
if (estado$n_atual < estado$Nmax) {
estado$n_atual <- estado$n_atual + 1
}
})
# Reset
observeEvent(input$reset, {
estado$baralho  <- NULL
estado$escolhas <- NULL
estado$n_atual  <- 0
estado$Nmax     <- NULL
})
# Informações textuais
output$infoCarta <- renderText({
if (is.null(estado$baralho) || estado$n_atual == 0)
return("Nenhuma carta revelada ainda.")
paste0("Carta ", estado$n_atual, " — valor: ", estado$baralho[estado$n_atual])
})
output$escolhasAlunos <- renderText({
req(estado$escolhas)
paste("Escolhas dos alunos:", paste(estado$escolhas, collapse = ", "))
})
# Imagem da carta atual
output$imagemCarta <- renderUI({
req(estado$baralho, estado$n_atual)
arquivo <- paste0(estado$baralho[estado$n_atual], ".png")
tags$img(src = arquivo, width = "80%")
})
# Gráfico
output$grafico <- renderPlot({
req(estado$baralho, estado$escolhas, estado$n_atual > 0)
n <- estado$n_atual
trajs <- lapply(
estado$escolhas,
trajetoria_aluno,
baralho = estado$baralho,
n = n
)
df <- tibble(
carta   = rep(1:n, times = input$nAlunos),
aluno   = rep(paste0("Aluno_", 1:input$nAlunos), each = n),
escolha = rep(estado$escolhas, each = n),
X       = unlist(trajs)
)
ggplot(df, aes(carta, X, color = aluno)) +
geom_line(linewidth = 1.2) +
geom_point(size = 2) +
labs(
title = paste0("Trajetórias com ", input$m, " baralhos e ", estado$Nmax, " cartas"),
subtitle = "Sequências variam, depois estacionam quando o número esgota nas cartas reveladas",
x = "Carta revelada",
y = "Contagem acumulada"
) +
theme_minimal(16) +
theme(legend.position = "bottom")
})
}
# Run
shinyApp(ui, server)
runApp('Fundamentos de Estatística/Dinâmicas/CadMarkov_Baralho.R')
runApp('Fundamentos de Estatística/Dinâmicas/CadMarkov_Baralho.R')
runApp('Fundamentos de Estatística/Dinâmicas/CadMarkov_Baralho.R')
## -------------------- 0) Paths and helper sources ----------------------------
## This script fits two Bayesian probit IRT models to a large-scale assessment dataset:
##   (1) Testlet 2PP (accounts for local item dependence within predefined testlets)
##   (2) Standard 2PP (assumes local independence across all items)
##
## It then produces posterior summaries and comparison plots for:
##   - Discrimination parameters (a)
##   - Difficulty parameters (b)
##   - Testlet correlation parameters (rho_global)
##
## Repository paths (edit if your local clone differs)
root_local    <- "~/GitHub/bayesian-testlet-antedependence"
path_project  <- "~/GitHub/bayesian-testlet-antedependence/Real Data Analysis/Large-Scale Educational Assessment"
stopifnot(dir.exists(root_local), dir.exists(path_project))
setwd(path_project)
## ------------------------- 1) Setup and packages -----------------------------
## Core: rstan (model fitting) + tidyverse stack (data wrangling + ggplot)
## Extra: mvtnorm/tmvtnorm, loo, shinystan are loaded because helper functions
## and/or downstream diagnostics may rely on them.
suppressPackageStartupMessages({
library(rstan)
library(rstansim)
library(shinystan)
library(data.table)
library(dplyr)
library(tidyr)
library(stringr)
library(tmvtnorm)
library(mvtnorm)
library(here)
library(loo)
library(ggplot2)
library(purrr)
library(tibble)
})
## Stan configuration
options(mc.cores = parallel::detectCores())
rstan_options(auto_write = TRUE)
## Simple timing utilities for logging blocks
tic <- function(msg) {
cat(sprintf("\n[START] %s ... %s\n", msg, Sys.time()))
Sys.time()
}
toc <- function(t0) {
cat(sprintf("[ END ] Elapsed: %s\n", Sys.time() - t0))
}
## Path to Stan programs (shared across analyses)
pathProgram <- here(root_local, "Programs")
## Source helper functions used for indexing + diagnostics (Q3, envelopes, heatmaps, etc.)
## This file is expected to be part of the repository.
source(here("Real Data Analysis", "HelpersRealDataAnal.R"))
## Output directories (model fits and figures)
pathFit <- here(path_project, "Fit")
dir.create(pathFit, showWarnings = FALSE, recursive = TRUE)
stopifnot(dir.exists(pathFit))
saveFigures <- here(pathFit, "Figures")
dir.create(saveFigures, showWarnings = FALSE, recursive = TRUE)
stopifnot(dir.exists(saveFigures))
