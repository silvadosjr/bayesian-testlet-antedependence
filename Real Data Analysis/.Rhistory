library(survival)
library(survMisc)
# --- Exemplo: dados 'veteran' do survival
# tempo: survival time
# status: 1 = evento, 0 = censura
# trt: grupo de tratamento (1 vs 2)
data(veteran)
# Kaplan-Meier apenas para visualizar
fit_km <- survfit(Surv(time, status) ~ trt, data = veteran)
plot(fit_km, col = 1:2, lwd = 2,
xlab = "Tempo", ylab = "Probabilidade de Sobrevivência")
legend("topright", legend = c("Tratamento 1", "Tratamento 2"), col = 1:2, lwd = 2)
# ------------------------------------------------------------
# 1. Log-rank (rho = 0)
# ------------------------------------------------------------
lr <- survdiff(Surv(time, status) ~ trt, data = veteran, rho = 0)
print(lr)
# ------------------------------------------------------------
# 2. Wilcoxon (Gehan-Breslow, rho = 1)
# ------------------------------------------------------------
wil <- survdiff(Surv(time, status) ~ trt, data = veteran, rho = 1)
print(wil)
# ------------------------------------------------------------
# 3. Tarone-Ware (peso intermediário: rho = 0.5)
#    No survdiff, podemos passar qualquer valor de rho.
# ------------------------------------------------------------
tw <- survdiff(Surv(time, status) ~ trt, data = veteran, rho = 0.5)
print(tw)
# ------------------------------------------------------------
# 4. Fleming-Harrington (classe G^p,q)
#    Implementação no pacote survMisc (teste G-rho-gamma)
# ------------------------------------------------------------
fh <- Grho(Surv(time, status) ~ trt, data = veteran, rho = 1, gamma = 0)   # p=1,q=0
# ------------------------------------------------------------
# 4. Fleming-Harrington (classe G^p,q)
#    Implementação no pacote survMisc (teste G-rho-gamma)
# ------------------------------------------------------------
fh <- Grho(Surv(time, status) ~ trt, data = veteran, rho = 1, gamma = 0)   # p=1,q=0
if (!requireNamespace("survMisc", quietly = TRUE)) install.packages("survMisc")
