stop("Link 'logit' não implementado com correlação; use 'probit'.")
}
}
}
Y
}
## ------------------------------------------------------------
## 6) Definição da grade de cenários (39 total, conforme combinado)
##    - Núcleo 3x3: K ∈ {4,5,6}, Ik padrões/diagonais, rho1 ∈ {fraca,moderada,forte}
##    - Bloco A: gerador indep (2PP sem LID) replicando K x Ik
##    - Bloco B(i): bcsm (constante)
##    - Bloco B(ii): unstructured
##    - Extras ρ=0: 3 (um por K) usando toeplitz com rho1=0
## ------------------------------------------------------------
make_scenarios <- function() {
# Para simplicidade, defina três perfis de Ik diferentes por K:
Ik_sets <- list(
`4` = c(2,2,3,3),     # total 10
`5` = c(2,3,3,4,4),   # total 16
`6` = c(2,2,3,3,4,4)  # total 18
)
levels_K <- c(4,5,6)
rho_levels <- c("fraca","moderada","forte")
rho_map <- list(fraca = 0.20, moderada = 0.50, forte = 0.80)
# 9 do núcleo (toeplitz, 3 K x 3 rho); para cada K escolha um único Ik_set
core <- do.call(rbind, lapply(levels_K, function(K) {
do.call(rbind, lapply(rho_levels, function(rn) {
data.frame(block = "core",
structure = "toeplitz",
K = K,
Ik = I(list(Ik_sets[[as.character(K)]])),
rho1 = rho_map[[rn]],
rho_const = NA_real_,
target_rho = NA_real_,
rho_label = rn,
stringsAsFactors = FALSE)
}))
}))
# 9 Bloco A (indep) replicando K x rho_label (mantemos rótulo, rho1 NA)
A <- core
A$block <- "A"
A$structure <- "indep"
A$rho1 <- NA_real_
A$rho_const <- NA_real_
A$target_rho <- NA_real_
# 9 Bloco B(i) bcsm: use rho_const compatível com "fraca/moderada/forte"
B1 <- core
B1$block <- "B1"
B1$structure <- "bcsm"
B1$rho_const <- with(B1, ifelse(rho_label=="fraca", 0.20,
ifelse(rho_label=="moderada", 0.50, 0.80)))
B1$rho1 <- NA_real_
B1$target_rho <- NA_real_
# 9 Bloco B(ii) unstructured (usa target_rho ~ nível)
B2 <- core
B2$block <- "B2"
B2$structure <- "unstructured"
B2$target_rho <- with(B2, ifelse(rho_label=="fraca", 0.20,
ifelse(rho_label=="moderada", 0.50, 0.80)))
B2$rho1 <- NA_real_
B2$rho_const <- NA_real_
# 3 extras rho=0 (toeplitz com rho1=0, um por K)
extra0 <- do.call(rbind, lapply(levels_K, function(K) {
data.frame(block = "extra_rho0",
structure = "toeplitz",
K = K,
Ik = I(list(Ik_sets[[as.character(K)]])),
rho1 = 0.0,
rho_const = NA_real_,
target_rho = NA_real_,
rho_label = "zero",
stringsAsFactors = FALSE)
}))
rbind(core, A, B1, B2, extra0)
}
## ------------------------------------------------------------
## 7) Função principal: gerar uma réplica de um cenário
## ------------------------------------------------------------
simulate_one_rep <- function(n = 350,
a_prior = list(type="lognormal", meanlog=0, sdlog=0.5),
b_prior = list(type="normal", mean=0, sd=1),
theta_spec = list(dist="normal", pars=list(mean=0, sd=1)),
permute_within = TRUE,
scenario_row) {
K  <- scenario_row$K
Ik <- unlist(scenario_row$Ik[[1]])  # lista -> vetor
bp <- make_test_blueprint(K, Ik, permute_within = permute_within)
# Parâmetros dos itens:
pars <- generate_item_params(I = nrow(bp), a_prior = a_prior, b_prior = b_prior)
a <- pars$a; b <- pars$b
# Traços latentes:
thetas <- generate_thetas(n, dist = theta_spec$dist, pars = theta_spec$pars)
# Correlações por testlet:
CorrList <- build_corr_by_testlet(
bp,
structure   = scenario_row$structure,
rho1        = scenario_row$rho1 %||% 0.5,
rho_const   = scenario_row$rho_const %||% 0.3,
target_rho  = scenario_row$target_rho %||% 0.4
)
# Simula respostas (probit):
Y <- simulate_irt_testlet(n, bp, a, b, thetas, CorrList, link = "probit")
list(
Y = Y,
theta = thetas,
a = a,
b = b,
blueprint = bp,
CorrList = CorrList,
meta = list(
n = n,
K = K,
Ik = Ik,
structure = scenario_row$structure,
block = scenario_row$block,
rho_label = scenario_row$rho_label,
rho1 = scenario_row$rho1,
rho_const = scenario_row$rho_const,
target_rho = scenario_row$target_rho,
permuted = permute_within
)
)
}
## ------------------------------------------------------------
## 8) Exemplo de uso: gerar a grade e simular UMA réplica por cenário
##    (na prática, repetir R vezes por cenário e salvar em disco)
## ------------------------------------------------------------
scenarios <- make_scenarios()
nrow(scenarios)  # 39
# Exemplo: simula 1 réplica no 1º cenário
ex <- simulate_one_rep(
n = 350,
a_prior = list(type="lognormal", meanlog=0, sdlog=0.5),
b_prior = list(type="normal", mean=0, sd=1),
theta_spec = list(dist="normal", pars=list(mean=0, sd=1)),
permute_within = TRUE,
scenario_row = scenarios[1, ]
)
str(ex, max.level = 1)
ex$CorrList
View(scenarios)
View(ex)
ex[["CorrList"]]
View(scenarios)
scenarios$Ik
