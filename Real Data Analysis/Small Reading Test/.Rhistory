J <- matrix(c(1, 0, 0, sigma_hat), nrow = 2, byrow = TRUE)
vcov_ln<- J%*%vcov_ln%*%t(J)  # Cov(mu, sigma) na escala natural
# --- Funções auxiliares para o método delta -------------------------
# Média: E(T) = exp(mu + sigma^2 / 2)
E_T <- exp(mu_hat + sigma_hat^2 / 2)
# Gradiente (derivadas parciais)
d_mu    <- E_T                      # d/dmu
d_sigma <- E_T * sigma_hat          # d/dsigma
grad_E <- c(d_mu, d_sigma)
# Variância delta: Var[E(T)] ≈ grad' * Cov * grad
var_E <- t(grad_E) %*% vcov_ln %*% grad_E
se_E  <- sqrt(var_E)
# Intervalo de 95% IC(E(T))
z <- qnorm(0.975)
IC_E <- c(E_T - z * se_E, E_T + z * se_E)
# --- Mediana: t_0.5 = exp(mu + sigma * z_0.5) = exp(mu)
t_med <- exp(mu_hat)
# Gradiente da mediana
d_mu_med    <- t_med
d_sigma_med <- 0
grad_med <- c(d_mu_med, d_sigma_med)
# Variância e IC(delta)
var_med <- t(grad_med) %*% vcov_ln %*% grad_med
se_med  <- sqrt(var_med)
IC_med <- c(t_med - z * se_med, t_med + z * se_med)
# --- Resultados finais --------------------------------------------
cat("\nEstimativas sob modelo log-normal\n")
cat(sprintf("Média estimada: %.2f horas (IC95%%: %.1f ; %.1f)\n",
E_T, IC_E[1], IC_E[2]))
cat(sprintf("Mediana estimada: %.2f horas (IC95%%: %.1f ; %.1f)\n",
t_med, IC_med[1], IC_med[2]))
ln_fit
ln_fit$res
ln_fit$res.t
coef_ln
ln_fit
ln_fit$res.t
## ------------------------------
## Dinâmica: Contagem por aluno
## ------------------------------
set.seed(123)
# Função para gerar um baralho (apenas valores 1 a 13)
gera_baralho <- function() {
rep(1:13, each = 4)
}
# Função que produz a trajetória de um aluno
trajetoria_aluno <- function(numero_escolhido, baralho) {
X <- numeric(length(baralho))
count <- 0
for (i in seq_along(baralho)) {
if (baralho[i] == numero_escolhido) count <- count + 1
X[i] <- count
}
return(X)
}
# ------- Simulação --------
n_alunos <- 8                        # número de alunos simulados
escolhas <- sample(1:13, n_alunos)   # cada aluno escolhe um número
baralho  <- sample(gera_baralho())   # embaralha o baralho
# Obtém trajetórias
traj <- lapply(escolhas, trajetoria_aluno, baralho = baralho)
View(traj)
traj[[2]]
# Coloca tudo em data frame longo
library(tidyverse)
df <- tibble(
carta   = rep(1:52, times = n_alunos),
aluno   = rep(paste0("Aluno_", seq_len(n_alunos)), each = 52),
escolha = rep(escolhas, each = 52),
X       = unlist(traj)
)
View(df)
ggplot(df, aes(x = carta, y = X, color = aluno)) +
geom_line(linewidth = 1) +
geom_point(size = 1.3) +
labs(
title = "Dinâmica de Processos Estocásticos: Contagem ao Revelar o Baralho",
subtitle = "Cada aluno conta somente as ocorrências do número que escolheu",
x = "Carta revelada",
y = "Contagem acumulada (X_n)"
) +
theme_minimal(base_size = 14) +
theme(legend.position = "bottom")
# ---------------------------------------------------------------
# Dinâmica do Baralho: Cartas reveladas uma a uma (Shiny)
# Para projeção em sala de aula
# ---------------------------------------------------------------
library(shiny)
library(tidyverse)
# -------------------------------
# Funções auxiliares
# -------------------------------
gera_baralho <- function() {
rep(1:13, each = 4)
}
trajetoria_aluno <- function(numero_escolhido, baralho, n) {
# trajetória até a carta n
X <- numeric(n)
count <- 0
for (i in 1:n) {
if (baralho[i] == numero_escolhido) count <- count + 1
X[i] <- count
}
return(X)
}
# -------------------------------
# UI
# -------------------------------
ui <- fluidPage(
titlePanel("Dinâmica de Processos Estocásticos: Contagem ao Revelar o Baralho"),
sidebarLayout(
sidebarPanel(
numericInput("nAlunos", "Número de alunos (simulados):", 6, min = 1, max = 20),
actionButton("sortear", "Sortear números dos alunos"),
hr(),
actionButton("revelar", "Revelar próxima carta"),
actionButton("reset", "Reiniciar"),
hr(),
verbatimTextOutput("infoCarta")
),
mainPanel(
plotOutput("grafico", height = "500px")
)
)
)
# -------------------------------
# Server
# -------------------------------
server <- function(input, output, session) {
# estado reativo
estado <- reactiveValues(
baralho = NULL,
escolhas = NULL,
n_atual = 0
)
# Sortear números
observeEvent(input$sortear, {
estado$baralho <- sample(gera_baralho())
estado$escolhas <- sample(1:13, input$nAlunos, replace = TRUE)
estado$n_atual <- 0
})
# Revelar próxima carta
observeEvent(input$revelar, {
req(estado$baralho)
if (estado$n_atual < 52) {
estado$n_atual <- estado$n_atual + 1
}
})
# Reiniciar
observeEvent(input$reset, {
estado$baralho <- NULL
estado$escolhas <- NULL
estado$n_atual <- 0
})
# Informação da carta atual
output$infoCarta <- renderText({
if (is.null(estado$baralho) || estado$n_atual == 0) {
return("Nenhuma carta revelada ainda.")
}
paste0("Carta ", estado$n_atual, ": valor = ", estado$baralho[estado$n_atual])
})
# Gráfico atualizado
output$grafico <- renderPlot({
req(estado$baralho, estado$escolhas)
n <- estado$n_atual
if (n == 0) return(NULL)
trajetorias <- lapply(
estado$escolhas,
trajetoria_aluno,
baralho = estado$baralho,
n = n
)
df <- tibble(
carta   = rep(1:n, times = input$nAlunos),
aluno   = rep(paste0("Aluno_", 1:input$nAlunos), each = n),
escolha = rep(estado$escolhas, each = n),
X       = unlist(trajetorias)
)
ggplot(df, aes(x = carta, y = X, color = aluno)) +
geom_line(linewidth = 1.2) +
geom_point(size = 2) +
labs(
title = "Trajetórias de Contagem ao Revelar as Cartas",
subtitle = "As sequências variam no início, mas estacionam quando não há mais ocorrências do número escolhido",
x = "Carta revelada",
y = "Contagem acumulada X_n"
) +
theme_minimal(base_size = 16) +
theme(legend.position = "bottom")
})
}
# -------------------------------
# Run App
# -------------------------------
shinyApp(ui, server)
# ---------------------------------------------------------------
# Dinâmica Generalizada: m baralhos + N cartas reveladas
# ---------------------------------------------------------------
library(shiny)
library(tidyverse)
# -------------------------------
# Funções auxiliares
# -------------------------------
gera_baralhos <- function(m) {
# m baralhos → cada valor aparece 4*m vezes
rep(1:13, each = 4 * m)
}
trajetoria_aluno <- function(numero_escolhido, baralho, n) {
X <- numeric(n)
count <- 0
for (i in 1:n) {
if (baralho[i] == numero_escolhido) count <- count + 1
X[i] <- count
}
X
}
# -------------------------------
# UI
# -------------------------------
ui <- fluidPage(
titlePanel("Dinâmica de Processos Estocásticos — m Baralhos e N Cartas"),
sidebarLayout(
sidebarPanel(
numericInput("m", "Número de baralhos:", 3, min = 1, max = 20),
numericInput("N", "Número de cartas a revelar:", 60, min = 1),
numericInput("nAlunos", "Número de alunos (simulados):", 6, min = 1, max = 50),
actionButton("sortear", "Gerar baralho e sortear números"),
hr(),
actionButton("revelar", "Revelar próxima carta"),
actionButton("reset", "Reiniciar"),
hr(),
verbatimTextOutput("infoCarta"),
verbatimTextOutput("escolhasAlunos")
),
mainPanel(
fluidRow(
column(6, plotOutput("grafico", height = "500px")),
column(6, uiOutput("imagemCarta"))
)
)
)
)
# -------------------------------
# SERVER
# -------------------------------
server <- function(input, output, session) {
estado <- reactiveValues(
baralho = NULL,
escolhas = NULL,
n_atual = 0,
Nmax = NULL
)
# Sortear setup inicial
observeEvent(input$sortear, {
# criar N cartas de m baralhos
baralho_full <- sample(gera_baralhos(input$m))
# garantir que temos cartas suficientes
if (input$N > length(baralho_full)) {
estado$Nmax <- length(baralho_full)
} else {
estado$Nmax <- input$N
}
# selecionar N cartas
estado$baralho <- baralho_full[1:estado$Nmax]
# alunos escolhem
estado$escolhas <- sample(1:13, input$nAlunos, replace = TRUE)
estado$n_atual <- 0
})
# Revelar carta
observeEvent(input$revelar, {
req(estado$baralho)
if (estado$n_atual < estado$Nmax) {
estado$n_atual <- estado$n_atual + 1
}
})
# Reset
observeEvent(input$reset, {
estado$baralho  <- NULL
estado$escolhas <- NULL
estado$n_atual  <- 0
estado$Nmax     <- NULL
})
# Informações textuais
output$infoCarta <- renderText({
if (is.null(estado$baralho) || estado$n_atual == 0)
return("Nenhuma carta revelada ainda.")
paste0("Carta ", estado$n_atual, " — valor: ", estado$baralho[estado$n_atual])
})
output$escolhasAlunos <- renderText({
req(estado$escolhas)
paste("Escolhas dos alunos:", paste(estado$escolhas, collapse = ", "))
})
# Imagem da carta atual
output$imagemCarta <- renderUI({
req(estado$baralho, estado$n_atual)
arquivo <- paste0(estado$baralho[estado$n_atual], ".png")
tags$img(src = arquivo, width = "80%")
})
# Gráfico
output$grafico <- renderPlot({
req(estado$baralho, estado$escolhas, estado$n_atual > 0)
n <- estado$n_atual
trajs <- lapply(
estado$escolhas,
trajetoria_aluno,
baralho = estado$baralho,
n = n
)
df <- tibble(
carta   = rep(1:n, times = input$nAlunos),
aluno   = rep(paste0("Aluno_", 1:input$nAlunos), each = n),
escolha = rep(estado$escolhas, each = n),
X       = unlist(trajs)
)
ggplot(df, aes(carta, X, color = aluno)) +
geom_line(linewidth = 1.2) +
geom_point(size = 2) +
labs(
title = paste0("Trajetórias com ", input$m, " baralhos e ", estado$Nmax, " cartas"),
subtitle = "Sequências variam, depois estacionam quando o número esgota nas cartas reveladas",
x = "Carta revelada",
y = "Contagem acumulada"
) +
theme_minimal(16) +
theme(legend.position = "bottom")
})
}
# Run
shinyApp(ui, server)
runApp('Fundamentos de Estatística/Dinâmicas/CadMarkov_Baralho.R')
runApp('Fundamentos de Estatística/Dinâmicas/CadMarkov_Baralho.R')
runApp('Fundamentos de Estatística/Dinâmicas/CadMarkov_Baralho.R')
## -------------------- 0) Paths and helper sources ----------------------------
root_local <- "~/GitHub/bayesian-testlet-antedependence"
path_project <- "~/GitHub/bayesian-testlet-antedependence/Real Data Analysis/Small Reading Test"
stopifnot(dir.exists(root_local), dir.exists(path_project))
setwd(path_project)
## ------------------------- 1) Setup and packages -----------------------------
suppressPackageStartupMessages({
library(rstan)
library(rstansim)
library(shinystan)
library(data.table)
library(dplyr)
library(tidyr)
library(stringr)
library(tmvtnorm)
library(mvtnorm)
library(here)
library(loo)
library(ggplot2)
library(purrr)
library(tibble)
})
options(mc.cores = parallel::detectCores())
rstan_options(auto_write = TRUE)
## Simple timing utilities for logging blocks
tic <- function(msg) { cat(sprintf("\n[START] %s ... %s\n", msg, Sys.time())); Sys.time() }
toc <- function(t0)  { cat(sprintf("[ END ] Elapsed: %s\n", Sys.time() - t0)) }
## Path to Stan programs
pathProgram <- here(root_local, "Programs")
## Source helper functions used for indexing + diagnostics (Q3, envelopes, heatmaps, etc.)
source(here('Real Data Analysis', "HelpersRealDataAnal.R"))
## Output directories
pathFit <- here(path_project, "Fit")
dir.create(pathFit, showWarnings = FALSE, recursive = TRUE)
stopifnot(dir.exists(pathFit))
saveFigures <- here(pathFit, "Figures")
dir.create(saveFigures, showWarnings = FALSE, recursive = TRUE)
stopifnot(dir.exists(saveFigures))
## ------------------- 2) Load TRAIN data — Small Reading test -----------------
## TRAIN split (students)
file_train <- file.path(path_project, "ld_train.rds")
stopifnot(file.exists(file_train))
base_train <- readRDS(file_train)
## Response matrix (drop first column, typically an ID)
mYc   <- base_train[, -1]
mYcNA <- as.data.frame(mYc)
## Replace missing responses with 0 for Stan input.
## IMPORTANT: confirm this missingness strategy is appropriate for your application.
mYcNA[is.na(mYc)] <- 0L
## Basic checks
n  <- nrow(mYcNA)
vI <- ncol(mYcNA)
stopifnot(n > 0, vI > 0)
## Reorder items to match the intended testlet ordering (must be consistent across train/test)
mYcNA <- mYcNA[, c(1, 6, 4, 5, 2, 3)]
## -------------------- 3) Testlet structure and indices -----------------------
## Declared testlet structure:
##  - K: number of testlets
##  - nk: lengths of each testlet
##  - dk: starting positions (if required by the Stan program)
##  - is_HU: flags controlling HU/HT-style rho indexing used by helper functions
K  <- 3
nk <- c(2, 2, 2)
dk <- c(1, 3, 5)
is_HU <- c(TRUE, TRUE, TRUE)  # kept as provided
## Build rho indexing (rho_len, rho_start, etc.) used by Stan + postprocessing
idx <- make_rho_index(nk, is_HU)
## Items that do NOT belong to any testlet (none in this example)
ind_items <- integer(0L)
## Consistency check: testlet items are complement of ind_items
all_items     <- seq_len(vI)
testlet_items <- setdiff(all_items, ind_items)
stopifnot(length(testlet_items) == sum(nk))
## Split items into testlets according to nk (order matters for diagnostics)
idx_testlets <- split(sort(testlet_items), rep(seq_along(nk), times = nk))
stopifnot(
sum(lengths(idx_testlets)) == length(testlet_items),
length(idx_testlets) == K
)
## --------------------- 4) Data lists for Stan --------------------------------
## Testlet-2PP (probit) with local dependence (Diag version, includes log_lik)
data_testlet <- list(
I = vI, N = n, K = K, dk = dk, nk = nk,
ind_items = ind_items, n_ind = vI - sum(nk),
Y = mYcNA,
sigma_a = .6, sigma_b = 4, sigma_rho = 1,
rho_len = idx$rho_len, S_mc = 200,
rho_start = idx$rho_start
)
## Standard 2PP (probit), no local dependence (includes log_lik)
data_2pp <- list(
N = n, vI = vI, Y = mYcNA,
sigma_a = .6, sigma_b = 4
)
## ---------------------- 5) Initial values and sampling -----------------------
## Standardized raw score used to initialize theta
scores <- scale(rowSums(mYcNA))[ ,1]
## (i) Testlet-2PP includes rho_global
init_testlet <- function() {
list(
theta = as.numeric(scores),
a     = rep(0.1, vI),
b     = rep(0.1, vI),
rho_global = rep(0.1, sum(idx$rho_len))
)
}
## (ii) Standard 2PP has no rho_global
init_2pp <- function() {
list(
theta = as.numeric(scores),
a     = rep(0.1, vI),
b     = rep(0.1, vI)
)
}
## Monitored parameters (log_lik included for LOO / model comparison)
pars_testlet <- c("a", "b", "theta", "rho_global", "log_lik")
pars_2pp     <- c("a", "b", "theta", "log_lik")
## NUTS settings (kept modest for speed)
nChains       <- 1
burnInSteps   <- 1000
thinSteps     <- 20
numSavedSteps <- 1000
nIter         <- ceiling(burnInSteps + numSavedSteps * thinSteps)
ctrl_nuts     <- list(adapt_delta = 0.8, max_treedepth = 10)
## Reload (useful if running only postprocessing)
fit_testlet <- readRDS(file.path(pathFit, "ResultTestlet2PP_SmallReading_CrossValidation.rds"))
fit_2pp     <- readRDS(file.path(pathFit, "Result2PP_SmallReading_CrossValidation.rds"))
## ------------------------- 7) Holdout (students) -----------------------------
## Load TEST split (students)
file_test <- file.path(path_project, "ld_test.rds")
stopifnot(file.exists(file_test))
base_test <- readRDS(file_test)
## Keep same item columns (drop ID) and apply same missingness handling
mYc_test   <- base_test[, -1]
mYcNA_test <- as.data.frame(mYc_test)
mYcNA_test[is.na(mYc_test)] <- 0L
N_test <- nrow(mYcNA_test)  # number of holdout students
## IMPORTANT: reorder items identically to TRAIN to preserve testlet mapping
mYcNA_test <- mYcNA_test[, c(1, 6, 4, 5, 2, 3)]
## ------------------------- 8) Basic post-processing --------------------------
## Extract posterior draws (arrays) needed by helper functions:
##  - build_params_testlet_from_arrays()
##  - build_params_2pp_from_arrays()
post_testlet <- rstan::extract(
fit_testlet,
pars = c("a", "b", "rho_global"),
permuted = TRUE
)
post_2pp <- rstan::extract(
fit_2pp,
pars = c("a", "b"),
permuted = TRUE
)
## ---------------------- Delta-Q3 heatmaps (TEST) -----------------------------
## Compute delta-Q3 by testlet:
##  - For each model, estimate Q3 structure on holdout data,
##  - Compare via heatmaps (both full and differences-only).
df_testlet <- delta_q3_testlet(
post_testlet,
function(draw_id, ext) build_params_testlet_from_arrays(draw_id, ext, idx, nk, K),
mYc_test,
idx_testlets,
R_eval      = 100,
model_label = "Testlet 2PP"
)
df_2pp <- delta_q3_testlet(
post_2pp,
function(draw_id, ext) build_params_2pp_from_arrays(draw_id, ext),
mYc_test,
idx_testlets,
R_eval      = 100,
model_label = "2PP"
)
save_delta_q3_heatmap_eps(
df_testlet,
df_2pp,
diff_only = FALSE,
file      = file.path(saveFigures, "Heatmap_DeltaQ3_Testlet_vs_2PP_SmallReading.eps")
)
saveFigures
