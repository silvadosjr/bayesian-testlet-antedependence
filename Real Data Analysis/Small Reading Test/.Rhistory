set.seed(123)
# Função para gerar um baralho (apenas valores 1 a 13)
gera_baralho <- function() {
rep(1:13, each = 4)
}
# Função que produz a trajetória de um aluno
trajetoria_aluno <- function(numero_escolhido, baralho) {
X <- numeric(length(baralho))
count <- 0
for (i in seq_along(baralho)) {
if (baralho[i] == numero_escolhido) count <- count + 1
X[i] <- count
}
return(X)
}
# ------- Simulação --------
n_alunos <- 8                        # número de alunos simulados
escolhas <- sample(1:13, n_alunos)   # cada aluno escolhe um número
baralho  <- sample(gera_baralho())   # embaralha o baralho
# Obtém trajetórias
traj <- lapply(escolhas, trajetoria_aluno, baralho = baralho)
View(traj)
traj[[2]]
# Coloca tudo em data frame longo
library(tidyverse)
df <- tibble(
carta   = rep(1:52, times = n_alunos),
aluno   = rep(paste0("Aluno_", seq_len(n_alunos)), each = 52),
escolha = rep(escolhas, each = 52),
X       = unlist(traj)
)
View(df)
ggplot(df, aes(x = carta, y = X, color = aluno)) +
geom_line(linewidth = 1) +
geom_point(size = 1.3) +
labs(
title = "Dinâmica de Processos Estocásticos: Contagem ao Revelar o Baralho",
subtitle = "Cada aluno conta somente as ocorrências do número que escolheu",
x = "Carta revelada",
y = "Contagem acumulada (X_n)"
) +
theme_minimal(base_size = 14) +
theme(legend.position = "bottom")
# ---------------------------------------------------------------
# Dinâmica do Baralho: Cartas reveladas uma a uma (Shiny)
# Para projeção em sala de aula
# ---------------------------------------------------------------
library(shiny)
library(tidyverse)
# -------------------------------
# Funções auxiliares
# -------------------------------
gera_baralho <- function() {
rep(1:13, each = 4)
}
trajetoria_aluno <- function(numero_escolhido, baralho, n) {
# trajetória até a carta n
X <- numeric(n)
count <- 0
for (i in 1:n) {
if (baralho[i] == numero_escolhido) count <- count + 1
X[i] <- count
}
return(X)
}
# -------------------------------
# UI
# -------------------------------
ui <- fluidPage(
titlePanel("Dinâmica de Processos Estocásticos: Contagem ao Revelar o Baralho"),
sidebarLayout(
sidebarPanel(
numericInput("nAlunos", "Número de alunos (simulados):", 6, min = 1, max = 20),
actionButton("sortear", "Sortear números dos alunos"),
hr(),
actionButton("revelar", "Revelar próxima carta"),
actionButton("reset", "Reiniciar"),
hr(),
verbatimTextOutput("infoCarta")
),
mainPanel(
plotOutput("grafico", height = "500px")
)
)
)
# -------------------------------
# Server
# -------------------------------
server <- function(input, output, session) {
# estado reativo
estado <- reactiveValues(
baralho = NULL,
escolhas = NULL,
n_atual = 0
)
# Sortear números
observeEvent(input$sortear, {
estado$baralho <- sample(gera_baralho())
estado$escolhas <- sample(1:13, input$nAlunos, replace = TRUE)
estado$n_atual <- 0
})
# Revelar próxima carta
observeEvent(input$revelar, {
req(estado$baralho)
if (estado$n_atual < 52) {
estado$n_atual <- estado$n_atual + 1
}
})
# Reiniciar
observeEvent(input$reset, {
estado$baralho <- NULL
estado$escolhas <- NULL
estado$n_atual <- 0
})
# Informação da carta atual
output$infoCarta <- renderText({
if (is.null(estado$baralho) || estado$n_atual == 0) {
return("Nenhuma carta revelada ainda.")
}
paste0("Carta ", estado$n_atual, ": valor = ", estado$baralho[estado$n_atual])
})
# Gráfico atualizado
output$grafico <- renderPlot({
req(estado$baralho, estado$escolhas)
n <- estado$n_atual
if (n == 0) return(NULL)
trajetorias <- lapply(
estado$escolhas,
trajetoria_aluno,
baralho = estado$baralho,
n = n
)
df <- tibble(
carta   = rep(1:n, times = input$nAlunos),
aluno   = rep(paste0("Aluno_", 1:input$nAlunos), each = n),
escolha = rep(estado$escolhas, each = n),
X       = unlist(trajetorias)
)
ggplot(df, aes(x = carta, y = X, color = aluno)) +
geom_line(linewidth = 1.2) +
geom_point(size = 2) +
labs(
title = "Trajetórias de Contagem ao Revelar as Cartas",
subtitle = "As sequências variam no início, mas estacionam quando não há mais ocorrências do número escolhido",
x = "Carta revelada",
y = "Contagem acumulada X_n"
) +
theme_minimal(base_size = 16) +
theme(legend.position = "bottom")
})
}
# -------------------------------
# Run App
# -------------------------------
shinyApp(ui, server)
# ---------------------------------------------------------------
# Dinâmica Generalizada: m baralhos + N cartas reveladas
# ---------------------------------------------------------------
library(shiny)
library(tidyverse)
# -------------------------------
# Funções auxiliares
# -------------------------------
gera_baralhos <- function(m) {
# m baralhos → cada valor aparece 4*m vezes
rep(1:13, each = 4 * m)
}
trajetoria_aluno <- function(numero_escolhido, baralho, n) {
X <- numeric(n)
count <- 0
for (i in 1:n) {
if (baralho[i] == numero_escolhido) count <- count + 1
X[i] <- count
}
X
}
# -------------------------------
# UI
# -------------------------------
ui <- fluidPage(
titlePanel("Dinâmica de Processos Estocásticos — m Baralhos e N Cartas"),
sidebarLayout(
sidebarPanel(
numericInput("m", "Número de baralhos:", 3, min = 1, max = 20),
numericInput("N", "Número de cartas a revelar:", 60, min = 1),
numericInput("nAlunos", "Número de alunos (simulados):", 6, min = 1, max = 50),
actionButton("sortear", "Gerar baralho e sortear números"),
hr(),
actionButton("revelar", "Revelar próxima carta"),
actionButton("reset", "Reiniciar"),
hr(),
verbatimTextOutput("infoCarta"),
verbatimTextOutput("escolhasAlunos")
),
mainPanel(
fluidRow(
column(6, plotOutput("grafico", height = "500px")),
column(6, uiOutput("imagemCarta"))
)
)
)
)
# -------------------------------
# SERVER
# -------------------------------
server <- function(input, output, session) {
estado <- reactiveValues(
baralho = NULL,
escolhas = NULL,
n_atual = 0,
Nmax = NULL
)
# Sortear setup inicial
observeEvent(input$sortear, {
# criar N cartas de m baralhos
baralho_full <- sample(gera_baralhos(input$m))
# garantir que temos cartas suficientes
if (input$N > length(baralho_full)) {
estado$Nmax <- length(baralho_full)
} else {
estado$Nmax <- input$N
}
# selecionar N cartas
estado$baralho <- baralho_full[1:estado$Nmax]
# alunos escolhem
estado$escolhas <- sample(1:13, input$nAlunos, replace = TRUE)
estado$n_atual <- 0
})
# Revelar carta
observeEvent(input$revelar, {
req(estado$baralho)
if (estado$n_atual < estado$Nmax) {
estado$n_atual <- estado$n_atual + 1
}
})
# Reset
observeEvent(input$reset, {
estado$baralho  <- NULL
estado$escolhas <- NULL
estado$n_atual  <- 0
estado$Nmax     <- NULL
})
# Informações textuais
output$infoCarta <- renderText({
if (is.null(estado$baralho) || estado$n_atual == 0)
return("Nenhuma carta revelada ainda.")
paste0("Carta ", estado$n_atual, " — valor: ", estado$baralho[estado$n_atual])
})
output$escolhasAlunos <- renderText({
req(estado$escolhas)
paste("Escolhas dos alunos:", paste(estado$escolhas, collapse = ", "))
})
# Imagem da carta atual
output$imagemCarta <- renderUI({
req(estado$baralho, estado$n_atual)
arquivo <- paste0(estado$baralho[estado$n_atual], ".png")
tags$img(src = arquivo, width = "80%")
})
# Gráfico
output$grafico <- renderPlot({
req(estado$baralho, estado$escolhas, estado$n_atual > 0)
n <- estado$n_atual
trajs <- lapply(
estado$escolhas,
trajetoria_aluno,
baralho = estado$baralho,
n = n
)
df <- tibble(
carta   = rep(1:n, times = input$nAlunos),
aluno   = rep(paste0("Aluno_", 1:input$nAlunos), each = n),
escolha = rep(estado$escolhas, each = n),
X       = unlist(trajs)
)
ggplot(df, aes(carta, X, color = aluno)) +
geom_line(linewidth = 1.2) +
geom_point(size = 2) +
labs(
title = paste0("Trajetórias com ", input$m, " baralhos e ", estado$Nmax, " cartas"),
subtitle = "Sequências variam, depois estacionam quando o número esgota nas cartas reveladas",
x = "Carta revelada",
y = "Contagem acumulada"
) +
theme_minimal(16) +
theme(legend.position = "bottom")
})
}
# Run
shinyApp(ui, server)
runApp('Fundamentos de Estatística/Dinâmicas/CadMarkov_Baralho.R')
runApp('Fundamentos de Estatística/Dinâmicas/CadMarkov_Baralho.R')
runApp('Fundamentos de Estatística/Dinâmicas/CadMarkov_Baralho.R')
## -------------------- 0) Paths and helper sources ----------------------------
root_local <- "~/GitHub/bayesian-testlet-antedependence"
path_project <- "~/GitHub/bayesian-testlet-antedependence/Real Data Analysis/Small Reading Test"
stopifnot(dir.exists(root_local), dir.exists(path_project))
setwd(path_project)
## ------------------------- 1) Setup and packages -----------------------------
suppressPackageStartupMessages({
library(rstan)
library(rstansim)
library(shinystan)
library(data.table)
library(dplyr)
library(tidyr)
library(stringr)
library(tmvtnorm)
library(mvtnorm)
library(here)
library(loo)
library(ggplot2)
library(purrr)
library(tibble)
})
options(mc.cores = parallel::detectCores())
rstan_options(auto_write = TRUE)
## Simple timing utilities for logging
tic <- function(msg) { cat(sprintf("\n[START] %s ... %s\n", msg, Sys.time())); Sys.time() }
toc <- function(t0)  { cat(sprintf("[ END ] Elapsed: %s\n", Sys.time() - t0)) }
## Path to Stan programs
pathProgram <- here(root_local, "Programs")
## Source helper functions used below (e.g., make_rho_index)
source(here(path_project, "HelpersRealDataAnal.R"))
## Output directories
pathFit <- here(path_project, "Fit")
dir.create(pathFit, showWarnings = FALSE, recursive = TRUE)
stopifnot(dir.exists(pathFit))
saveFigures <- here(pathFit, "Figures")
dir.create(saveFigures, showWarnings = FALSE, recursive = TRUE)
stopifnot(dir.exists(saveFigures))
## ------------------- 2) Load data — Small Reading test -----------------------
## (a) Full dataset (used here as "training" set)
file_full <- file.path(path_project, "ld_Small_reading_test.txt")
stopifnot(file.exists(file_full))
base_full <- read.table(file_full)
## Response matrix:
##  - remove first column (typically an ID),
##  - keep 0/1 with NAs for missing.
mYc   <- base_full[, -1]
mYcNA <- as.data.frame(mYc)
## Replace missing with 0 for Stan input (common in these pipelines).
## IMPORTANT: confirm that missingness treatment is appropriate for your study.
mYcNA[is.na(mYc)] <- 0L
## Basic checks
n  <- nrow(mYcNA)  # number of respondents
vI <- ncol(mYcNA)  # number of items
stopifnot(n > 0, vI > 0)
## Reorder items to match the intended testlet ordering
mYcNA <- mYcNA[, c(1, 6, 4, 5, 2, 3)]
## -------------------- 3) Testlet structure and indices -----------------------
## Declared structure:
##  - K = number of testlets
##  - nk = number of items in each testlet
##  - dk = starting positions (if required by the Stan program)
##  - is_HU = logical flags controlling the HU/HT structure used by helper code
K  <- 3
nk <- c(2, 2, 2)
dk <- c(1, 3, 5)
is_HU <- c(TRUE, TRUE, TRUE)  # user-defined pattern; kept as-is
## Build indices used to map rho parameters into testlets
idx <- make_rho_index(nk, is_HU)  # provides $rho_len, $rho_start, etc.
## Independent items (items not belonging to any testlet)
ind_items <- integer(0L)
## Consistency checks: testlet items are the complement of independent items
all_items     <- seq_len(vI)
testlet_items <- setdiff(all_items, ind_items)
stopifnot(length(testlet_items) == sum(nk))
## Partition items by testlet according to nk
idx_testlets <- split(sort(testlet_items), rep(seq_along(nk), times = nk))
stopifnot(
sum(lengths(idx_testlets)) == length(testlet_items),
length(idx_testlets) == K
)
## --------------------- 4) Data lists for Stan -------------------------------
## Testlet-2PP (probit) — "HT general" version (per Stan file naming)
data_testlet <- list(
I = vI, N = n, K = K, dk = dk, nk = nk,
ind_items = ind_items, n_ind = vI - sum(nk),
Y = mYcNA,
sigma_a = .6, sigma_b = 4, sigma_rho = 1,
rho_len = idx$rho_len, S_mc = 200,
rho_start = idx$rho_start
)
## Standard 2PP (probit) under local independence
data_2pp <- list(
N = n, vI = vI, Y = mYcNA,
sigma_a = .6, sigma_b = 4
)
## ---------------------- 5) Initial values -----------------------------------
## Standardized raw score as an initializer for theta
scores <- scale(rowSums(mYcNA))[ ,1]
## (i) Testlet-2PP includes rho_global
init_testlet <- function() {
list(
theta = as.numeric(scores),
a     = rep(0.1, vI),
b     = rep(0.1, vI),
rho_global = rep(0.1, sum(idx$rho_len))
)
}
## (ii) Standard 2PP does not include rho_global
init_2pp <- function() {
list(
theta = as.numeric(scores),
a     = rep(0.1, vI),
b     = rep(0.1, vI)
)
}
## Parameters to monitor
pars_testlet <- c("a", "b", "theta", "rho_global")
pars_2pp     <- c("a", "b", "theta")
## NUTS settings (kept modest for speed)
nChains       <- 1
burnInSteps   <- 1000
thinSteps     <- 20
numSavedSteps <- 1000
nIter         <- ceiling(burnInSteps + numSavedSteps * thinSteps)
ctrl_nuts     <- list(adapt_delta = 0.8, max_treedepth = 10)
## Reload (useful when running only the plotting block)
fit_testlet <- readRDS(file.path(pathFit, "ResultTestlet2PP_SmallReading.rds"))
fit_2pp     <- readRDS(file.path(pathFit, "Result2PP_SmallReading.rds"))
## ======================= Posterior summaries and plots =======================
## Helper to extract posterior summaries from rstan::summary()
post_summary <- function(fit, pars) {
ss <- rstan::summary(fit, pars = pars)$summary
out <- as.data.frame(ss)
out$Parameter <- rownames(ss)
rownames(out) <- NULL
out
}
## Summaries: Testlet model
sum_a1     <- post_summary(fit_testlet, "a")
sum_b1     <- post_summary(fit_testlet, "b")
sum_theta1 <- post_summary(fit_testlet, "theta")
sum_rho    <- post_summary(fit_testlet, "rho_global")
## Summaries: Standard 2PP
sum_a2     <- post_summary(fit_2pp, "a")
sum_b2     <- post_summary(fit_2pp, "b")
sum_theta2 <- post_summary(fit_2pp, "theta")
## Extract numeric indices from parameter names like "a[13]" or "theta[200]"
get_param_index <- function(param_vec, par) {
mat <- stringr::str_match(param_vec, sprintf("^%s\\[(\\d+)\\]$", par))
idx <- suppressWarnings(as.integer(mat[, 2]))  # NA for non-matching rows
idx
}
## Keep only valid entries and sort by their numeric index
order_param_df <- function(df, par) {
idx <- get_param_index(df$Parameter, par)
keep <- !is.na(idx)
df2 <- df[keep, , drop = FALSE]
idx2 <- idx[keep]
df2[order(idx2), , drop = FALSE]
}
## Apply ordering (important for consistent item alignment across models)
sum_a1     <- order_param_df(sum_a1,     "a")
sum_a2     <- order_param_df(sum_a2,     "a")
sum_b1     <- order_param_df(sum_b1,     "b")
sum_b2     <- order_param_df(sum_b2,     "b")
sum_theta1 <- order_param_df(sum_theta1, "theta")
sum_theta2 <- order_param_df(sum_theta2, "theta")
## ------------------ Build labels for rho parameters --------------------------
## Create expressions like T_k(rho[r]) where r runs over rho_len[k]
build_rho_labels <- function(rho_len) {
exprs <- list()
for (k in seq_along(rho_len)) {
for (r in seq_len(rho_len[k])) {
exprs[[length(exprs) + 1]] <- bquote(T[.(k)](rho[.(r)]))
}
}
as.expression(exprs)
}
rho_labels <- build_rho_labels(idx$rho_len)
rho_data <- data.frame(
Rho = seq_len(sum(idx$rho_len)),
Estimate = sum_rho$mean,
CI_Low   = sum_rho$`2.5%`,
CI_High  = sum_rho$`97.5%`
)
## ------------------ Build labels for item axis (testlets) --------------------
## Map each item to its testlet (or NA if independent)
testlet_of_item <- rep(NA_integer_, vI)
for (k in seq_along(idx_testlets)) {
testlet_of_item[idx_testlets[[k]]] <- k
}
## Item labels:
##  - independent items: "i"
##  - testlet items: T_k(i)
build_item_labels <- function(vI, testlet_of_item) {
labs <- vector("list", vI)
for (i in seq_len(vI)) {
k <- testlet_of_item[i]
labs[[i]] <- if (is.na(k)) {
bquote(.(i))
} else {
bquote(T[.(k)](.(i)))
}
}
as.expression(labs)
}
item_labels <- build_item_labels(vI, testlet_of_item)
## -------------------------- Plot styling -------------------------------------
## Grayscale palette for model comparison
scale_cols <- scale_color_manual(values = c("Testlet 2PP" = "grey50", "2PP" = "black"))
## -------------------------- Plot: rho ----------------------------------------
p_rho <- ggplot(rho_data, aes(x = Rho, y = Estimate)) +
geom_point(size = 2, color = "black") +
geom_errorbar(aes(ymin = CI_Low, ymax = CI_High), width = 0.15, color = "black") +
geom_hline(yintercept = 0, linetype = "dashed") +
theme_minimal(base_size = 14) +
scale_x_continuous(breaks = rho_data$Rho, labels = rho_labels) +
labs(x = NULL, y = "Estimate")
p_rho
